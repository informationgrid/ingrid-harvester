{
  "compilerOptions": {
    "strict": false,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "mocha",
      "chai",
      "sinon"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators":true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "exclude": [
    "node_modules"
  ]
}
