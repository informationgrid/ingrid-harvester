    {
      "@type": "dcat:Dataset",
      "@id": "1ffd46e88f774d0887a05c63ffa3b342",
      "dct:identifier": "https://www.arcgis.com/home/item.html?id=1ffd46e88f774d0887a05c63ffa3b342",
      "dct:landingPage": "https://open-data.stadtatlas.dessau-rosslau.de/apps/dero::tag-des-offenen-denkmals-13-09-2026",
      "dct:title": "Tag des offenen Denkmals 13.09.2026",
      "dct:description": "NetzWERKE: Denkmale & Infrastruktur Der bundesweite Tag des offenen Denkmals findet am 13. September 2026 unter dem Motto „NetzWERKE: Denkmale & Infrastruktur“ statt. Mit diesem Motto dreht sich beim Tag des offenen Denkmals alles um Infrastrukturen, also Versorgung, Verbindungen und Verkehr. Das Thema eröffnet Möglichkeiten, auch neue Perspektiven an Denkmalen aufzuzeigen. Die Bandbreite an Netzwerken ist groß: Energie- und Transportnetze, Infrastrukturnetze bis hin zu Eisenbahnen, Verkehrswegen und Brücken, die verbinden. Die Nutzung von Denkmalen, oft durch Vereine und Institutionen mit vielfältigen Angeboten, bereichern die städtische Infrastruktur. Die Geschichten der Denkmale in ihrer Einzigartigkeit sollen in den Blickpunkt gerückt werden.",
      "dcat:theme": "Stadtatlas Apps,Apps_Kultur, Freizeit, Tourismus",
      "dcat:keyword": "",
      "foaf:page": {
        "foaf:Document": "https://www.arcgis.com/sharing/rest/content/items/1ffd46e88f774d0887a05c63ffa3b342/info/metadata/metadata.xml?format=default",
