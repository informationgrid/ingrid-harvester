    "@testcontainers/postgresql": "^12.1.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^7.1.8",
    "@types/deep-equal-in-any-order": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/keycloak-connect": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/sinon": "^7.5.2",
    "chai": "^5.3.3",
    "chai-as-promised": "^7.1.2",
    "chai-exclude": "^3.0.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "deep-equal-in-any-order": "^2.2.0",
    "eslint": "^8.57.1",
    "mocha": "^12.0.1",
    "mocha-junit-reporter": "^2.2.1",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.14",
    "rdf-isomorphic": "^1.3.1",
    "rdfxml-streaming-parser": "^2.4.0",
    "sinon": "^8.1.1",
    "testcontainers": "^12.1.0",
    "typescript": "~6.0.3"
  },
  "pkg": {
    "scripts": "build/**/*.js",
    "assets": [
      "./log4js.json",
      "./config.json",
      "./config-general.json",
      "./def_licenses.rdf"
    ]
  },
  "optionalDependencies": {
    "@oxc-resolver/binding-linux-x64-gnu": "^11.24.2",
    "@swc/core-linux-x64-gnu": "^1.16.2"
  }
}
