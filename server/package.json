{
  "name": "ingrid-harvester",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "",
  "type": "module",
  "exports": "./app/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node --import @swc-node/register/esm-register --enable-source-maps app/index.ts",
    "start-cli": "pm2 start ./app/server-cli.js --no-autorestart",
    "start-dev": "cross-env IMPORTER_PROFILE=mcloud nodemon",
    "start-diplanung": "cross-env IMPORTER_PROFILE=diplanung ELASTIC_PREFIX=diplan- ELASTIC_INDEX=harvester nodemon",
    "start-lvr": "cross-env IMPORTER_PROFILE=lvr ELASTIC_PREFIX=lvr- ELASTIC_INDEX=harvester nodemon",
    "start-ingrid": "cross-env IMPORTER_PROFILE=ingrid nodemon --config_dir=./config/ingrid",
    "start-zdm": "cross-env IMPORTER_PROFILE=zdm nodemon",
    "build-with-tests": "tsc --outDir build",
    "build": "tsc --outDir build -p ./tsconfig.build.json",
    "postbuild": "copyfiles './*.json' './*.rdf' 'keycloak.json' 'app/**/*.json' 'app/**/*.sql' 'app/**/*.xml' 'app/**/*.md' 'app/**/*.rdf' build/server",
    "install-production": "NODE_ENV=production npm ci --omit=optional --omit=dev",
    "test": "mocha test/**/*.spec.ts --exclude test/diplanung/**/*.spec.ts",
    "test-jenkins": "cross-env IMPORTER_PROFILE=mcloud mocha test/mcloud/*.spec.ts --colors --reporter mocha-junit-reporter --reporter-options mochaFile=report.xml",
    "test-jenkins-diplanung": "cross-env IMPORTER_PROFILE=diplanung mocha test/diplanung/*.spec.ts --colors --reporter mocha-junit-reporter --reporter-options mochaFile=report.xml"
  },
  "author": "andre.wallat@wemove.com",
  "license": "EUPL",
  "dependencies": {
    "@bbob/html": "^4.4.1",
    "@bbob/preset-html5": "^4.4.1",
    "@tsed/common": "^8.38.7",
    "@tsed/components-scan": "^8.38.7",
    "@tsed/core": "^8.38.7",
    "@tsed/di": "^8.38.7",
    "@tsed/exceptions": "^8.38.7",
    "@tsed/platform-express": "^8.38.7",
    "@tsed/schema": "^8.38.7",
    "@tsed/socketio": "^8.38.7",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/boolean-within": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/combine": "^7.4.0",
    "@turf/flatten": "^7.4.0",
    "@turf/flip": "^7.4.0",
    "@turf/rewind": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@xmldom/xmldom": "^0.8.15",
    "body-parser": "^1.20.8",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cron": "^3.5.0",
    "dayjs": "^1.11.23",
    "deep-equal": "^2.2.3",
    "elasticsearch8": "npm:@elastic/elasticsearch@^8.19.2",
    "elasticsearch9": "npm:@elastic/elasticsearch@^9.5.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "gray-matter": "^4.0.3",
    "iconv-lite": "^0.6.3",
    "image-size": "^2.0.4",
    "js-sha512": "^0.8.0",
    "keycloak-connect": "^26.1.1",
    "lodash-es": "^4.18.1",
    "log4js": "^6.9.1",
    "marked": "^15.0.12",
    "memorystore": "^1.6.8",
    "method-override": "^3.0.0",
    "nodemailer": "^10.0.10",
    "p-limit": "^4.0.0",
    "p-queue": "^9.3.3",
    "p-throttle": "^6.2.0",
    "passport": "^0.6.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "proj4": "^2.22.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "sparql-http-client": "^2.4.2",
    "undici": "^8.10.2",
    "uuid": "^14.0.2",
    "xml-escape": "^1.1.0",
    "xpath": "^0.0.32"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
