{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "declaration": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "tslib": ["./node_modules/tslib"]
    },
    "useDefineForClassFields": false
  },
  "exclude": []
}
